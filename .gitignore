# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Local variable files, which may contain secrets
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Environment files and secrets
.env
.env.*
!.env.example
*.secret
*.secrets

# Private keys and certificates
*.pem
*.key
id_rsa
id_ed25519

# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/